# ============================================================================
# Data Penduduk (Google Sheets via Google Apps Script)
# ============================================================================
# URL Web App hasil deploy `dashboard-penduduk/apps-script/Code.gs`.
# Harus diakhiri dengan /exec
PENDUDUK_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# PIN admin yang diatur lewat menu "Data Penduduk > Atur / ganti PIN admin"
# di Google Sheets. Minimal 6 karakter.
PENDUDUK_PIN=123456

# Kunci tanda tangan sesi login aplikasi (opsional, ada nilai default).
AUTH_SECRET=ganti-dengan-kunci-acak-panjang
